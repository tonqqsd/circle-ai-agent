# Circle API Credentials
CIRCLE_API_KEY="YOUR_CIRCLE_API_KEY_HERE"
CIRCLE_ENTITY_SECRET="YOUR_32_BYTE_HEX_ENTITY_SECRET_HERE"
CIRCLE_FEE_POLICY_ID="" # Optional: For Gas Station sponsored transactions

# AI Provider Credentials (Gemini)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Agent Budget Config
# If an API price is below this amount (in USDC), the agent buys automatically.
# If it's higher, the agent asks for your permission first.
MAX_AUTO_BUY_BUDGET=1.0

# Testnet Settings
# Use 'ETH-SEPOLIA', 'MATIC-AMOY', or 'AVAX-FUJI'
BLOCKCHAIN="ETH-SEPOLIA"

# Optional: Add a wallet set ID if you already have one, otherwise the code will generate one
WALLET_SET_ID=""
